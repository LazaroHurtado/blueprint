{
  "name": "blueprint",
  "private": true,
  "version": "0.1.0",
  "description": "A local visual editor for GitHub Copilot dynamic workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LazaroHurtado/blueprint.git"
  },
  "homepage": "https://github.com/LazaroHurtado/blueprint#readme",
  "bugs": {
    "url": "https://github.com/LazaroHurtado/blueprint/issues"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-vm-modules --experimental-test-module-mocks --test src/*.test.ts scripts/*.test.mjs",
    "check": "tsc --noEmit && node scripts/check-repository.mjs",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "notices": "node scripts/generate-notices.mjs",
    "package": "npm run notices && tauri build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@xyflow/react": "^12",
    "zod": "^4"
  },
  "devDependencies": {
    "@github/copilot-sdk": "^1.0.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^26",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
